# BOUNCER_ALLOW_DEMO_EDGE_TOKEN=true
# BOUNCER_BUFFER_PATH=bouncer_audit.db
# BOUNCER_CV_RATE_LIMIT_PER_MINUTE=30
# BOUNCER_FILL_RATE_LIMIT_PER_MINUTE=120
# BOUNCER_MAX_BODY_BYTES=65536
