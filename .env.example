# Full URL for edge fill telemetry ingestion (interceptor + recovery worker).
CENTRAL_LEDGER_URL=http://127.0.0.1:8000/api/v1/telemetry/fill

# Optional: local SQLite WAL buffer path on the shop-floor device.
# EDGE_BUFFER_PATH=edge_buffer.db

# Optional: used by main.py to document the default ledger URL in / root response.
# API_HOST=127.0.0.1
# API_PORT=8000

# API Bouncer middleware (edge CV ingress + WAL audit buffer)
# BOUNCER_EDGE_TOKEN=edge-cam-prod-992-xtz
